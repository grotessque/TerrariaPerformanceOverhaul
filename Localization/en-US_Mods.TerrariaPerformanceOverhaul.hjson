# This file will automatically update with entries for new content after a build and reload.
# Please read https://github.com/tModLoader/tModLoader/wiki/Localization to learn more about localization and these files.

Configs: {
	TPOClientConfig: {
		DisplayName: TPO Client Settings

		Headers: {
			Diagnostics: Diagnostics
			BenchmarkTools: Benchmark tools
		}

		EnableDiagnostics: {
			Label: Enable diagnostics
			Tooltip:
				'''
				Master switch for TPO diagnostics: frame-time and memory measurements,
				the overlay, /tpo stats and /tpo bench.
				Off: TPO does no measurement work.
				'''
		}

		ShowOverlay: {
			Label: Show overlay
			Tooltip:
				'''
				Compact FPS / frame-time / memory overlay in the bottom-right corner.
				Requires "Enable diagnostics". Refreshed twice per second.
				'''
		}

		EnableBenchmarkTools: {
			Label: Enable benchmark tools
			Tooltip:
				'''
				Single player only. Enables chat commands that set up benchmark scenes:
				/tpo god, /tpo spawn, /tpo find, /tpo event, /tpo time, /tpo clear.
				They change the game state and the world when it is saved. Back up the world first.
				'''
		}
	}
}
