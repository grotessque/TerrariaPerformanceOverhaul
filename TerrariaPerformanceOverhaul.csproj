<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Import tModLoader mod properties. Resolution order:
		  1. TmlTargetsPath from the command line or environment:
		       dotnet build -p:TmlTargetsPath=/path/to/tModLoader/tMLMod.targets
		  2. TmlTargetsPath from tml.local.props (machine-specific, not in Git; see tml.local.props.example).
		  3. ..\tModLoader.targets — the standard ModSources layout generated by tModLoader.
	-->
	<Import Project="tml.local.props" Condition="Exists('tml.local.props')" />
	<PropertyGroup>
		<TmlTargetsPath Condition="'$(TmlTargetsPath)' == ''">..\tModLoader.targets</TmlTargetsPath>
	</PropertyGroup>
	<Import Project="$(TmlTargetsPath)" />

	<!-- General -->
	<PropertyGroup>
		<AssemblyName>TerrariaPerformanceOverhaul</AssemblyName>
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<!-- Test and helper projects are not part of the mod assembly. -->
	<ItemGroup>
		<Compile Remove="tests/**" />
		<None Remove="tests/**" />
	</ItemGroup>

	<!-- References -->
	<ItemGroup>

	</ItemGroup>

	<!--
		Build identity: put the Git commit into AssemblyInformationalVersion ("<version>+<commit>[-dirty]").
		TPOBuildIdentity reads it at runtime. If Git is unavailable, no commit is injected and TPO reports "unknown".
		A value supplied by the caller (-p:SourceRevisionId=...) has priority, for CI.
	-->
	<Target Name="TpoResolveSourceRevision" BeforeTargets="InitializeSourceControlInformation" Condition="'$(SourceRevisionId)' == ''">
		<Exec Command="git rev-parse --short=12 HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="TpoGitCommit" />
			<Output TaskParameter="ExitCode" PropertyName="TpoGitCommitExit" />
		</Exec>
		<Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" Condition="'$(TpoGitCommitExit)' == '0'">
			<Output TaskParameter="ConsoleOutput" PropertyName="TpoGitStatus" />
		</Exec>
		<PropertyGroup Condition="'$(TpoGitCommitExit)' == '0'">
			<SourceRevisionId>$(TpoGitCommit)</SourceRevisionId>
			<SourceRevisionId Condition="'$(TpoGitStatus)' != ''">$(TpoGitCommit)-dirty</SourceRevisionId>
		</PropertyGroup>
	</Target>

</Project>
